# Copy to .env.local and fill in from Supabase → Settings → API.
#
# Only these two. The `service_role` key must NEVER appear in this file or in
# any NEXT_PUBLIC_* variable — see CLAUDE.md §2 rule 3. Row Level Security
# (docs/SUPABASE_SCHEMA.sql) is what protects the anon key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's own origin, used for canonical URLs, OG images, the sitemap and
# robots.txt. Absolute URLs are not optional there — a scraper does not
# resolve a relative og:image, so a wrong value here means no link preview
# rather than a slightly wrong one.
#
# Leave blank locally. On Vercel, set it to the production domain once it
# exists; without it the build falls back to a guessed vercel.app hostname.
NEXT_PUBLIC_SITE_URL=
